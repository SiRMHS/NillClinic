# ═══════════════════════════════════════════════════════════
# Jordan Clinic Dashboard — Server .env
# Copy to project root:  cp deploy/.env.production.example .env
# ═══════════════════════════════════════════════════════════

# ─── GHCR images (must match GitHub Actions deploy.yml) ───
# Repo "Deon/Nill" → GHCR_IMAGE_PREFIX=deon/nill
GHCR_IMAGE_PREFIX=your-github-username/nill
IMAGE_TAG=1.2

# ─── PostgreSQL ───
DATABASE_PASSWORD=change-me-to-a-strong-password

# ─── JWT ───
JWT_SECRET=generate-with-openssl-rand-base64-64
JWT_EXPIRES_IN=24h

# ─── Field-level encryption (32 bytes base64) ───
ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# ─── Jordan CRM API ───
JORDAN_API_BASE_URL=http://your-crm-server
JORDAN_API_USERNAME=api
JORDAN_API_PASSWORD=your-crm-password
JORDAN_API_COMPANY=Jordan

# ─── Sync Engine ───
SYNC_CRON_ENABLED=true
SYNC_CRON_SCHEDULE=0 */6 * * *

# ─── Lead webhook (optional) ───
LEAD_WEBHOOK_SECRET=your-webhook-secret

# ─── Public URLs (your domain) ───
API_URL=https://your-domain.com/api
WEB_ORIGIN=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# ═══════════════════════════════════════════════════════════
# Server setup (run once):
#
#   # 1. Login to GHCR (token needs read:packages)
#   echo YOUR_GITHUB_TOKEN | docker login ghcr.io -u YOUR_GITHUB_USER --password-stdin
#
#   # 2. Pull and start
#   docker compose pull
#   docker compose up -d
#
#   # 3. Check health
#   docker compose ps
#   curl http://localhost:4000/health
#   curl http://localhost:3000/
# ═══════════════════════════════════════════════════════════
