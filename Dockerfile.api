# ─────────────────────────────────────────────────────────
# Jordan API — production image (built on GitHub Actions)
# ─────────────────────────────────────────────────────────
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
WORKDIR /app

# ── Build stage ──────────────────────────────────────────
FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/api apps/api/
COPY packages/db packages/db/
COPY packages/shared packages/shared/
COPY sync-engine sync-engine/

RUN pnpm install --frozen-lockfile

RUN pnpm --filter @jordan/shared build \
 && pnpm --filter @jordan/db generate \
 && pnpm --filter @jordan/db build \
 && pnpm --filter @jordan/sync-engine build \
 && pnpm --filter @jordan/api build

# pnpm deploy bundles workspace deps (@jordan/db, sync-engine, …)
# as real files — no broken symlinks at runtime.
RUN pnpm --filter @jordan/api deploy --prod --legacy /prod/api

# ── Runner stage ─────────────────────────────────────────
FROM base AS runner
RUN apk add --no-cache tini openssl ca-certificates wget \
 && npm install -g prisma@6.9.0

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /prod/api ./
COPY --from=build /app/packages/db/prisma ./prisma

COPY docker-entrypoint.api.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 4000
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/index.js"]
