# ─── PostgreSQL ───
DATABASE_URL="postgresql://jordan:jordan@localhost:5432/jordan_dashboard?schema=public"

# ─── Jordan CRM API (secapidocs.md) ───
JORDAN_API_BASE_URL="http://217.114.46.158"
JORDAN_API_USERNAME="api"
JORDAN_API_PASSWORD="jordan"
JORDAN_API_COMPANY="Jordan"

# ─── Field-level encryption (PII) ───
# 32-byte key, base64-encoded (generate: openssl rand -base64 32)
